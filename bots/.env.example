# Copy to bots/.env with mode 0600 before PM2 starts. Each bot reads the file on startup.
# Keep tokens in this file only. Use separate Discord bot credentials.
CODEX_DISCORD_BOT_TOKEN=replace-with-codex-discord-token
CLAUDE_DISCORD_BOT_TOKEN=replace-with-claude-discord-token

HQ_ROOT="~/path/to/hq"
BRIDGE_PRIVATE_DIR="~/path/to/hq/bots/codex-bridge/private"
# CLAUDE_PRIVATE_DIR="~/path/to/hq/bots/claude-relay/private"
# Optional. Paths can contain spaces. Leave unset to use the PM2 process PATH.
# CODEX_EXECUTABLE="/path/to/codex"
# CLAUDE_BIN="/path/to/claude"
# Default macOS Orca accounts directory. Set to override the saved routing root.
# CODEX_ACCOUNTS_ROOT="~/Library/Application Support/orca/codex-accounts"
